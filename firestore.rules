rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == '123adam133@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Blueprints
    function isValidNotification(data) {
      return data.keys().hasAll([
          'crewId',
          'recipientEmail',
          'senderUid',
          'flightNo',
          'type',
          'message',
          'read',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'crewId',
          'recipientEmail',
          'senderUid',
          'flightNo',
          'type',
          'message',
          'read',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.crewId) &&
        data.recipientEmail is string && data.recipientEmail.size() <= 254 &&
        data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
        data.flightNo is string && data.flightNo.size() <= 32 &&
        data.type is string && data.type.size() <= 32 &&
        data.type in ['FLIGHT_ASSIGNED', 'FLIGHT_UPDATED', 'GENERAL'] &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 1000 &&
        data.read is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRole(data) {
      return data.keys().hasAll([
          'name',
          'nameAr',
          'description',
          'perms',
          'active',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name',
          'nameAr',
          'description',
          'perms',
          'active',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 64 &&
        data.name.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.nameAr is string && data.nameAr.size() <= 64 &&
        data.description is string && data.description.size() <= 256 &&
        data.perms is list && data.perms.size() <= 200 &&
        (data.perms.size() == 0 || (data.perms[0] is string && data.perms[0].size() <= 64)) &&
        data.active is bool &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
        data.updatedBy == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWhatsappSettings(data) {
      return data.keys().hasAll([
          'whatsappPhoneNumber',
          'phoneNumberId',
          'whatsappApiKey',
          'provider',
          'autoNotifyFlights',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'whatsappPhoneNumber',
          'phoneNumberId',
          'whatsappApiKey',
          'provider',
          'autoNotifyFlights',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.whatsappPhoneNumber is string && data.whatsappPhoneNumber.size() <= 32 &&
        data.phoneNumberId is string && data.phoneNumberId.size() <= 64 &&
        data.whatsappApiKey is string && data.whatsappApiKey.size() <= 512 &&
        data.provider is string && data.provider.size() <= 32 &&
        data.provider in ['cloud_api', 'apps_script', 'wa_link'] &&
        data.autoNotifyFlights is bool &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
        data.updatedBy == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPermit(data) {
      return data.keys().hasAll([
          'flightId',
          'status',
          'country',
          'permitNo',
          'authorUid',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'flightId',
          'status',
          'country',
          'permitNo',
          'authorUid',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.flightId) &&
        data.status is string && data.status.size() <= 32 &&
        data.status in ['DRAFT', 'SUBMITTED', 'APPROVED', 'REJECTED', 'EXPIRED'] &&
        data.country is string && data.country.size() <= 64 &&
        data.permitNo is string && data.permitNo.size() <= 64 &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['email', 'role', 'createdAt']) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.role is string && data.role.size() <= 32 &&
        data.role in ['admin', 'superAdmin'] &&
        data.createdAt is timestamp;
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow get: if isVerifiedUser() && isValidId(notificationId) && (
        existing().senderUid == request.auth.uid ||
        (existing().recipientEmail != '' && existing().recipientEmail == request.auth.token.email) ||
        isAdmin()
      );

      allow list: if isVerifiedUser() && (
        existing().senderUid == request.auth.uid ||
        (existing().recipientEmail != '' && existing().recipientEmail == request.auth.token.email) ||
        isBootstrappedAdmin()
      );

      allow create: if isVerifiedUser() &&
        isValidId(notificationId) &&
        isValidNotification(incoming()) &&
        incoming().senderUid == request.auth.uid &&
        incoming().read == false &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(notificationId) &&
        isValidNotification(incoming()) &&
        incoming().crewId == existing().crewId &&
        incoming().senderUid == existing().senderUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            ((existing().recipientEmail != '' && existing().recipientEmail == request.auth.token.email) || existing().senderUid == request.auth.uid) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt'])
          )
        );

      allow delete: if isVerifiedUser() && isValidId(notificationId) && (
        existing().senderUid == request.auth.uid || isAdmin()
      );
    }

    // Roles Collection
    match /roles/{roleId} {
      allow get: if isVerifiedUser() && isValidId(roleId);

      allow list: if isBootstrappedAdmin() || (
        isVerifiedUser() && existing().active == true
      );

      allow create: if isVerifiedUser() &&
        isValidId(roleId) &&
        isValidRole(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isVerifiedUser() &&
        isValidId(roleId) &&
        isValidRole(incoming()) &&
        incoming().name == existing().name &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'nameAr',
          'description',
          'perms',
          'active',
          'updatedBy',
          'updatedAt'
        ]) &&
        isAdmin();

      allow delete: if isVerifiedUser() &&
        isValidId(roleId) &&
        roleId != 'superAdmin' &&
        isAdmin();
    }

    // Settings Collection (Secrets isolated to Admin get/write only — no list)
    match /settings/{settingsId} {
      allow get: if isVerifiedUser() && settingsId == 'whatsapp' && isAdmin();

      allow create: if isVerifiedUser() &&
        settingsId == 'whatsapp' &&
        isValidWhatsappSettings(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isVerifiedUser() &&
        settingsId == 'whatsapp' &&
        isValidWhatsappSettings(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'whatsappPhoneNumber',
          'phoneNumberId',
          'whatsappApiKey',
          'provider',
          'autoNotifyFlights',
          'updatedBy',
          'updatedAt'
        ]) &&
        isAdmin();

      allow delete: if false;
    }

    // Permits Collection
    match /permits/{permitId} {
      allow get: if isVerifiedUser() && isValidId(permitId) && (
        existing().authorUid == request.auth.uid || isAdmin()
      );

      allow list: if isVerifiedUser() && (
        existing().authorUid == request.auth.uid || isBootstrappedAdmin()
      );

      allow create: if isVerifiedUser() &&
        isValidId(permitId) &&
        isValidPermit(incoming()) &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(permitId) &&
        isValidPermit(incoming()) &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().authorUid == request.auth.uid &&
            existing().status != 'EXPIRED' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'country',
              'permitNo',
              'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser() && isValidId(permitId) && isAdmin();
    }

    // Admins Collection
    match /admins/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (
        request.auth.uid == userId || isAdmin()
      );

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidAdmin(incoming()) &&
        incoming().createdAt == request.time &&
        isBootstrappedAdmin();

      allow update: if false;

      allow delete: if isVerifiedUser() &&
        isValidId(userId) &&
        isBootstrappedAdmin();
    }
  }
}
